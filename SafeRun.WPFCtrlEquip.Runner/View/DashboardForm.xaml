        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <UserControl.Resources>
        <Style x:Key="defaultRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#88949A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="border" Margin="20,0,20,0" />
                            <ContentPresenter
                        x:Name="contentPresenter"
                        Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Focusable="False"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#8CEDCB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#8CEDCB" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,4" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="border" Property="BorderThickness" Value="0" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/SafeRun.WPFCtrlEquip.WPFRunner;component/View/back.jpg"
                Stretch="UniformToFill" />
        </Grid.Background>
        <!--  标题和工具栏  -->
        <Grid x:Name="title" Grid.Row="0">
            <Grid VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Source="/SafeRun.WPFCtrlEquip.WPFRunner;component/View/SafeRunLogon.ico" Margin="0,4,0,0" ></Image>

                <TextBlock
    Margin="38,5,0,0"
    VerticalAlignment="Center"
    FontSize="36"
    FontWeight="Bold"
    Foreground="#4F5050"
    Text="SafeRun" HorizontalAlignment="Left" Height="46" />

                <TextBlock
    VerticalAlignment="Center"
    FontSize="36"
    Foreground="White"
    Text="业务监控" HorizontalAlignment="Center" Height="46" />
                <Button x:Name="btn_AllPanel"
    Width="100"
    Height="30"
    Command="{Binding ClickFullLayoutCommand}"
    Content="全局面板" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30,0,0,0" />
            </Grid>

            <UniformGrid Grid.Column="1" Columns="3">

            </UniformGrid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="43*"/>
                <ColumnDefinition Width="21*"/>
            </Grid.ColumnDefinitions>
            <TabControl Loaded="TabControl_Loaded" Grid.ColumnSpan="2" >
                <TabItem Header="监控平台">
                    <!--<Grid Background="#FFE5E5E5"/>-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Button x:Name="btn_ReloadMonitor" Content="Reload" Click="btn_ReloadMonitor_Click" ></Button>
                        </Grid>
                        <Frame Grid.Row="1" x:Name="fra_monitorPage" VerticalAlignment="Top" Padding="0,15,0,0" NavigationUIVisibility="Hidden" />
                        <!--<ContentControl Grid.Row="1" x:Name="fra_monitorPage" VerticalAlignment="Top" Padding="0,15,0,0" />-->
                        <!--<Grid Grid.Row="1" x:Name="fra_monitorPage" />-->
                    </Grid>
                    
                </TabItem>
                <TabItem Header="任务信息">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Label Content="任务号" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBox x:Name="txt_TaskNo" HorizontalAlignment="Left" Margin="60,0,0,0"  Width="100" VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="170,0,0,0">
                                    <Label Content="任务状态" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <ComboBox x:Name="comB_TaskStatus" HorizontalAlignment="Left" Margin="60,0,0,0" Width="120" VerticalContentAlignment="Center" />

                                </Grid>
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="360,0,0,0">
                                    <Label Content="起源" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBox x:Name="txt_SLocNo" HorizontalAlignment="Left" Margin="60,0,0,0"  Width="120" VerticalContentAlignment="Center" />
                                </Grid>
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="550,0,0,0">
                                    <Label Content="目的" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBox x:Name="txt_DLocNo" HorizontalAlignment="Left" Margin="60,0,0,0"  Width="120" VerticalContentAlignment="Center" />

                                </Grid>
                                <Button x:Name="btn_TaskQuery" Content="查询" HorizontalAlignment="Left" Height="25" Width="75" Click="btn_TaskQuery_Click" Margin="762,0,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1">


                            </Grid>

                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{Binding TaskInfoList}" >
                                <ListView.Resources>
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <!--<EventSetter Event="Control.PreviewMouseDoubleClick" Handler="ListViewItem_PreviewMouseDoubleClick"/>-->
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                        <GridViewColumn Header="任务编号" DisplayMemberBinding="{Binding TaskNo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <!--<GridViewColumn Header="区域" DisplayMemberBinding="{Binding EquipName,UpdateSourceTrigger=PropertyChanged}" />-->
                                        <GridViewColumn Header="任务类别" DisplayMemberBinding="{Binding TaskType, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="下发时间" DisplayMemberBinding="{Binding ExecBTime, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                        <GridViewColumn Header="任务数量" DisplayMemberBinding="{Binding TaskQty, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="源站台" DisplayMemberBinding="{Binding SLocNo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="目标站台" DisplayMemberBinding="{Binding DLocNo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="当前站台" DisplayMemberBinding="{Binding CurrLocNo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="物料编码" DisplayMemberBinding="{Binding MaterCode, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <GridViewColumn Header="错误代码" DisplayMemberBinding="{Binding ErrCode, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="错误描述" DisplayMemberBinding="{Binding ErrDesc, UpdateSourceTrigger=PropertyChanged}" Width="600"/>

                                    </GridView>
                                </ListView.View>

                            </ListView>
                        </Grid>



                    </Grid>

                </TabItem>
                <TabItem Header="数据监控">
                    <Grid>
                        <Grid.RowDefinitions >
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="427*"/>
                                <ColumnDefinition Width="367*"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="100"
                                Height="30"
                                Command="{Binding refreshListItemCommand}"
                                Content="刷新" Margin="117,9,210,11" />
                            <CheckBox
                                Width="100"
                                Margin="27,16,300,4"
                                IsChecked="{Binding AutoRefresh}"
                                Content="自动刷新" Height="30" />

                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{Binding BlockInfoList}" >
                                <ListView.Resources>
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <!--<EventSetter Event="Control.PreviewMouseDoubleClick" Handler="ListViewItem_PreviewMouseDoubleClick"/>-->
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="节点编号" DisplayMemberBinding="{Binding BizNodeId, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <GridViewColumn Header="节点名称" DisplayMemberBinding="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                        <GridViewColumn Header="更新时间" DisplayMemberBinding="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                        <GridViewColumn Header="数据值" DisplayMemberBinding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <!--<GridViewColumn Header="序号" DisplayMemberBinding="{Binding LineId, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                        <GridViewColumn Header="设备ID" DisplayMemberBinding="{Binding EquipId, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="设备名称" DisplayMemberBinding="{Binding EquipName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                        <GridViewColumn Header="接口文件" DisplayMemberBinding="{Binding EquipImpl, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                        <GridViewColumn Header="数据块ID" DisplayMemberBinding="{Binding BlockId, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="数据块地址" DisplayMemberBinding="{Binding BlockStart, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <GridViewColumn Header="数据块长度" DisplayMemberBinding="{Binding BlockLen, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="读取频率" DisplayMemberBinding="{Binding ReadHz, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="设备状态" DisplayMemberBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn  Header="启动时间" DisplayMemberBinding="{Binding BeginTime, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                        <GridViewColumn Width="100" Header="耗时" DisplayMemberBinding="{Binding ExcuteMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <GridViewColumn Header="执行次数" DisplayMemberBinding="{Binding BeginCount, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="成功次数" DisplayMemberBinding="{Binding SuccessCount, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Header="失败次数" DisplayMemberBinding="{Binding FailedCount, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <GridViewColumn Width="180" Header="失败时间" DisplayMemberBinding="{Binding FailedSustainedTime, UpdateSourceTrigger=PropertyChanged}" />-->
                                    </GridView>
                                </ListView.View>

                            </ListView>
                        </Grid>
                    </Grid>

                </TabItem>
                <TabItem Header="设备异常记录">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- 查询条件 -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <Label Content="设备代码" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!--<ComboBox x:Name="comB_EquipmentCode" HorizontalAlignment="Left" Margin="60,0,0,0" Width="120" VerticalContentAlignment="Center" />-->
                                    <ComboBox x:Name="comB_EquipmentCode"
          HorizontalAlignment="Left"
          Margin="60,0,0,0"
          Width="120"
          VerticalContentAlignment="Center"
          ItemsSource="{Binding PlcCodeComB}"
          SelectedItem="{Binding SelectedPlcCode}"
          DisplayMemberPath="Value"
          SelectedValuePath="Key"/>
                                </Grid>
                                <Grid x:Name="stackPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="197,0,0,0">
                                    <StackPanel  Orientation="Horizontal">
                                        <Label Content="异常时间" />

                                        <hc:DatePicker  Width="140" Height="26" SelectedDateFormat="Short" SelectedDate="{Binding ErrorStartDate}" Tag="ErrorStartDate"/>
                                        <Label Content="~" />
                                        <hc:DatePicker  Width="140" Height="26" SelectedDateFormat="Long" SelectedDate="{Binding ErrorEndDate}" Tag="ErrorEndDate"/>
                                    </StackPanel>

                                </Grid>
                                <Button x:Name="btn_EquipmentQuery" Content="查询" HorizontalAlignment="Left" Height="25" Width="75" Click="btn_EquipmentError_Click" Margin="762,0,0,0"/>




                            </Grid>
                        </Grid>

                        <!-- 设备异常记录列表 -->
                        <Grid Grid.Row="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>

                                <!-- 设备异常记录列表 -->
                                <ListView ItemsSource="{Binding EquipmentErrorItems}" Grid.Row="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="设备编号" DisplayMemberBinding="{Binding PlcCode}" Width="80"/>
                                            <GridViewColumn Header="设备名称" DisplayMemberBinding="{Binding PlcName}" Width="120"/>
                                            <GridViewColumn Header="异常代码" DisplayMemberBinding="{Binding ErrCode}" Width="100"/>
                                            <GridViewColumn Header="异常明细" DisplayMemberBinding="{Binding ErrDetails}" Width="200"/>
                                            <GridViewColumn Header="异常时间" DisplayMemberBinding="{Binding ErrorDate}" Width="200"/>
                                            <GridViewColumn Header="异常名称" DisplayMemberBinding="{Binding ErrName}" Width="250"/>
                                            <GridViewColumn Header="订单号" DisplayMemberBinding="{Binding OrderNo}" Width="100"/>
                                            <GridViewColumn Header="异常解释" DisplayMemberBinding="{Binding ErrExplain}" Width="200"/>
                                            <GridViewColumn Header="任务号" DisplayMemberBinding="{Binding TaskNo}" Width="100"/>

                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- 分页控件 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2">
                                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="5"/>
                                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="5"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" Margin="5"/>
                                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5"/>
                                    <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="5"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>


    </Grid>

</UserControl>