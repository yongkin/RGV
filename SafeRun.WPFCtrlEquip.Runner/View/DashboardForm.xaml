<UserControl xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SafeRun.WPFCtrlEquip.WPFRunner"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:CustomizeControls="clr-namespace:SafeRun.WPFCtrlEquip.WPFRunner.CustomizeControls"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    x:Class="SafeRun.WPFCtrlEquip.WPFRunner.DashboardForm" 
    mc:Ignorable="d" 
    d:DesignHeight="1080"
    d:DesignWidth="1920">
    <!--<UserControl.Resources>
        <ResourceDictionary
            Source="pack://application:,,,/SafeRun.WPFCtrlEquip.WPFRunner;component/Resources/BaseStyles.xaml" />
    </UserControl.Resources>-->
