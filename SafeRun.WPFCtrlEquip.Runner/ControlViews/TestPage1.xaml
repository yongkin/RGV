<localClass:BasePageClass xmlns:CustomizeControls="clr-namespace:SafeRun.WPFCtrlEquip.WPFRunner.CustomizeControls"  x:Class="SafeRun.WPFCtrlEquip.WPFRunner.ControlViews.TestPage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SafeRun.WPFCtrlEquip.WPFRunner.ControlViews"
      xmlns:IP_Controls="clr-namespace:SafeRun.WCS.IP_Controls"
      xmlns:localClass="clr-namespace:SafeRun.WPFCtrlEquip.WPFRunner"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1000"
      >

    <localClass:BasePageClass.Resources>
        <ResourceDictionary Source="/SafeRun.WPFCtrlEquip.WPFRunner;component/SafeRun.WCS.IP_Controls/Themes/Generic.xaml" />
    </localClass:BasePageClass.Resources>



    <Grid Width="1000">

        <Rectangle Width="28" Height="5" Fill="Transparent" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
StrokeThickness="0.5" 
Margin="70,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Rectangle.StrokeDashArray>
                <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                2,3,2,3,24,3
            </Rectangle.StrokeDashArray>
        </Rectangle>

        <Grid x:Name="Shelves"  Height="20" Width="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,106,0,0" Background="#FFF48F1F" >


            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry Figures="M0,330 L100,330"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    12,2,4,2,4,2,16
                </Path.StrokeDashArray>
            </Path>
            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry Figures="M0,330 L100,330"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    12,2,4,2,4,2,16
                </Path.StrokeDashArray>
            </Path>

            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <!--M100,50 表示起点坐标（x=100, y=50）,L100,200 表示终点坐标（x=100, y=200）-->
                    <PathGeometry Figures="M100,50 L100,200"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    6,1,2,1,2,1,6
                </Path.StrokeDashArray>
            </Path>

            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <!--M100,50 表示起点坐标（x=100, y=50）,L100,200 表示终点坐标（x=100, y=200）-->
                    <PathGeometry Figures="M100,50 L100,200"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    6,1,2,1,2,1,6
                </Path.StrokeDashArray>
            </Path>

            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry Figures="M0,0 L200,360"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    10,2,2,2,12,2,2,2,16
                </Path.StrokeDashArray>
            </Path>
            <Path Stretch="Fill" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry Figures="M200,200 L0,360"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <!-- 定义虚线样式：两短虚线 + 两长虚线 -->
                    10,2,2,2,12,2,2,2,16
                </Path.StrokeDashArray>
            </Path>

        </Grid>

        <!--新版堆垛机样式-2025-06-12 变更-->
        <Grid x:Name="StackerContr"  Height="60" Width="537" VerticalAlignment="Top" >
            <Rectangle x:Name="rect" />

            <!--堆垛机内运行线样式-->
            <Grid Height="20" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="10">
                        <Rectangle Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" Width="2" Height="8" HorizontalAlignment="Right" />
                    </Grid>
                    <Path Stretch="Fill" Width="515"  Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" StrokeThickness="2" >
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Data>
                            <PathGeometry Figures="M58.079533,330 L162.4962,330"/>
                        </Path.Data>
                        <Path.StrokeDashArray>
                            <!-- 定义虚线样式：两短虚线 + 两长虚线 实、虚、实、虚 数值代表长度 -->
                            2, 2, 8, 2
                        </Path.StrokeDashArray>
                    </Path>
                    <Grid Width="10">
                        <Rectangle Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" Width="2" Height="8" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>


            </Grid>

            <!--上边货架-->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Height="20" Width="537" >

                <Path Stretch="Fill" Width="460" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Margin="-1,3,0,0" HorizontalAlignment="Center">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Data>
                        <PathGeometry Figures="M50,330 L162.4962,330"/>
                    </Path.Data>
                    <!--<Path.StrokeDashArray>
                         --><!--定义虚线样式：两短虚线 + 两长虚线--><!--
                        2,3,2,3,15,3
                    </Path.StrokeDashArray>-->
                </Path>

                <Path Stretch="Fill" Width="460" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
      Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Margin="-1,16,0,0">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Data>
                        <PathGeometry Figures="M58.079533,330 L162.4962,330"/>
                    </Path.Data>
                    <!--<Path.StrokeDashArray>
                         --><!--定义虚线样式：两短虚线 + 两长虚线--><!-- 
                        2,3,2,3,15,3
                    </Path.StrokeDashArray>-->
                </Path>


                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="CustomizeControls:StackerShelves_1">
                            <Setter Property="Margin" Value="0,0,2,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>

                </StackPanel>



            </Grid>
            <!--下边货架-->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,40,0,0" Height="20" Width="537" >

                <Path Stretch="Fill" Width="460" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Margin="-1,3,0,0" HorizontalAlignment="Center">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Data>
                        <PathGeometry Figures="M50,330 L162.4962,330"/>
                    </Path.Data>
                    <!--<Path.StrokeDashArray>
                         --><!--定义虚线样式：两短虚线 + 两长虚线--><!--
                        2,3,2,3,15,3
                    </Path.StrokeDashArray>-->
                </Path>

                <Path Stretch="Fill" Width="460" Fill="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
      Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" 
      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Margin="-1,16,0,0">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Data>
                        <PathGeometry Figures="M58.079533,330 L162.4962,330"/>
                    </Path.Data>
                    <!--<Path.StrokeDashArray>
                         --><!--定义虚线样式：两短虚线 + 两长虚线--><!-- 
                        2,3,2,3,15,3
                    </Path.StrokeDashArray>-->
                </Path>


                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="CustomizeControls:StackerShelves_1">
                            <Setter Property="Margin" Value="0,0,2,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>
                    <CustomizeControls:StackerShelves_1 HorizontalAlignment="Left"  VerticalAlignment="Center" Height="20" Width="40"/>

                </StackPanel>


            </Grid>

            <!--左侧 显示标题-不显示现在不用了-->
            <TextBox Text="{Binding ShowTitle, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="28" Height="15" Margin="6,3,0,0" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center"
VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" Visibility="Hidden" ></TextBox>

            <!--右侧 显示堆垛机状态-不显示现在不用了-->
            <Grid  Width="36" Height="18"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,0,0" Visibility="Hidden">

                <Rectangle   RadiusX="2" RadiusY="2" Fill="{x:Static IP_Controls:ColorLibrary.DefaultBackgroundColor}" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}"/>
                <!-- ModeLamp 手自动灯，常亮: 手动时:ManualRunColor ; 自动时: AutoRunColor -->
                <Ellipse x:Name="ModeLamp" Height="10" Width="10" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" >
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{x:Static IP_Controls:ColorLibrary.BorderColor}" />
                    </Ellipse.Fill>
                    <Ellipse.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="手自动灯" />
                            </StackPanel>
                        </ToolTip>
                    </Ellipse.ToolTip>
                </Ellipse>

                <!-- HeartbeatLamp 心跳灯，闪烁: 连通时:AutoRunColor ; 断开时: AlarmColor-->
                <Ellipse x:Name="HeartbeatLamp" Height="10" Width="10" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" >
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{x:Static IP_Controls:ColorLibrary.BorderColor}" />
                    </Ellipse.Fill>
                    <Ellipse.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="心跳灯" />
                            </StackPanel>
                        </ToolTip>
                    </Ellipse.ToolTip>
                </Ellipse>

            </Grid>
            
            <!--中间显示是否启用-->
            <Label Content="{Binding UseTxt, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="18" FontSize="9" Background="#FFFBF7F7" Margin="0,1,0,0" VerticalContentAlignment="Center" Padding="6,0,6,0"></Label>

            <!--显示库存量-->
            <Grid Height="15" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Width="373" >
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="空库位数:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                        <TextBox Text="{Binding CrnEmptyNum, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="35" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="有货位数:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                        <TextBox Text="{Binding CrnMaterNum, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="35" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="空托位数:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                        <TextBox Text="{Binding CrnPalletNum, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="35" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="库位使用率:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="65" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                        <TextBox Text="{Binding CrnRatio, RelativeSource={RelativeSource Mode=TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="35" Height="15" Background="White" FontSize="11" TextAlignment="Center"  IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionBrush="{x:Null}" BorderBrush="{x:Null}" ></TextBox>
                    </StackPanel>

                </StackPanel>



            </Grid>

            <!--运行堆垛机-->
            <Grid x:Name="StackerCrn" VerticalAlignment="Center" HorizontalAlignment="Left" Width="61" Margin="62,0,0,0">


                <Rectangle Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" Width="20" Height="60" HorizontalAlignment="Left" Fill="#FFFDFDFD" />



                <Grid  Width="18" Height="39" HorizontalAlignment="Left" Margin="-15,0,0,0"    >

                    <Rectangle   RadiusX="2" RadiusY="2" Fill="{x:Static IP_Controls:ColorLibrary.DefaultBackgroundColor}" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}"/>

                    <!-- ModeLamp 手自动灯，常亮: 手动时:ManualRunColor ; 自动时: AutoRunColor -->
                    <Ellipse x:Name="ModeLamp1" Height="10" Width="10" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" >
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Static IP_Controls:ColorLibrary.BorderColor}" />
                        </Ellipse.Fill>
                        <Ellipse.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="手自动灯" />
                                </StackPanel>
                            </ToolTip>
                        </Ellipse.ToolTip>
                    </Ellipse>

                    <!-- HeartbeatLamp 心跳灯，闪烁: 连通时:AutoRunColor ; 断开时: AlarmColor-->
                    <Ellipse x:Name="HeartbeatLamp1" Height="10" Width="10" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" >
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Static IP_Controls:ColorLibrary.BorderColor}" />
                        </Ellipse.Fill>
                        <Ellipse.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="心跳灯" />
                                </StackPanel>
                            </ToolTip>
                        </Ellipse.ToolTip>
                    </Ellipse>

                </Grid>

                <Grid Width="50" Height="43" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0" >
                    <!--<Rectangle Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" Fill="White"  />-->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="CustomizeControls:StackerShelves_1">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBox TextWrapping="Wrap"  Text="{Binding StackerTaskNo, RelativeSource={RelativeSource Mode=TemplatedParent}}" BorderBrush="{x:Static IP_Controls:ColorLibrary.BorderColorB}" TextAlignment="Center" HorizontalContentAlignment="Center"
VerticalContentAlignment="Center" IsReadOnly="True" FontSize="12" VerticalAlignment="Top" Width="48" Height="15" HorizontalAlignment="Center"  />
                        <TextBox TextWrapping="Wrap"  Text="{Binding StackerTaskNo, RelativeSource={RelativeSource Mode=TemplatedParent}}" BorderBrush="{x:Static IP_Controls:ColorLibrary.BorderColorB}" TextAlignment="Center" HorizontalContentAlignment="Center"
VerticalContentAlignment="Center" IsReadOnly="True" FontSize="12" VerticalAlignment="Center" Width="48" Height="15" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                        <TextBox TextWrapping="Wrap"  Text="{Binding StackerTaskNo, RelativeSource={RelativeSource Mode=TemplatedParent}}" BorderBrush="{x:Static IP_Controls:ColorLibrary.BorderColorB}" TextAlignment="Center" HorizontalContentAlignment="Center"
VerticalContentAlignment="Center" IsReadOnly="True" FontSize="12" VerticalAlignment="Top" Width="48" Height="15" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                    </StackPanel>


                </Grid>
            </Grid>

        </Grid>
        <IP_Controls:Stacker HorizontalAlignment="Left" VerticalAlignment="Top" Width="537" Height="60" Margin="17,146,0,0"/>
        <Image Margin="200,235,768,813" Source="/SafeRun.WPFCtrlEquip.WPFRunner;component/View/saferun64X64.png" Stretch="Fill"/>

    </Grid>
</localClass:BasePageClass>
