    <!--传感器样式-->
    <Style TargetType="{x:Type IP_Controls:Sensor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type IP_Controls:Sensor}">
                    <Viewbox x:Name="LayoutRoot" Stretch="Fill">
                        <!--控件标签设置-->
                        <Viewbox.ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{Binding ShowTitle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                <TextBlock Text="{Binding ShowContent, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            </StackPanel>
                        </Viewbox.ToolTip>
                        <VisualStateManager.VisualStateGroups>
                            <!--设置报警样式-->
                            <VisualStateGroup>

                                <VisualState x:Name="AlarmOff">

                                </VisualState>
                                <VisualState x:Name="AlarmOn">

                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!--控件图标-->
                        <Grid Height="15" Width="15">
                            <!--设置报警绑定控件 x:Name="rect" 与  Storyboard.TargetName="rect"  -->
                            <Rectangle x:Name="rect" HorizontalAlignment="Center" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" VerticalAlignment="Center" Stretch="Fill" Width="15" Height="15" />
                            <!--设置自动、手动模式背景颜色 ContrBackground 配置: TagReadText ="Show:AutoMode#AutoMode" -->
                            <Rectangle HorizontalAlignment="Center" Stroke="{x:Static IP_Controls:ColorLibrary.BorderColorB}" VerticalAlignment="Center" Stretch="Fill" Width="10" Height="10" Fill="{Binding ContrBackground, FallbackValue=IP_Controls:ColorLibrary.DefaultBackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--单纯测试使用-->
    <Style TargetType="{x:Type IP_Controls:TestControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type IP_Controls:TestControl}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="AlarmOn">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Storyboard.TargetName="rect">
                                            <DiscreteColorKeyFrame KeyTime="0:0:0.8" Value="Red"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <!-- Other animations go here -->
                                    </Storyboard>
                                </VisualState>
                                <!-- Other visual states go here -->
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Viewbox x:Name="viewbox" Stretch="Fill">
                            <!-- Your other elements go here -->
                        </Viewbox>

                        <Rectangle x:Name="rect" Width="50" Height="50">
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Fill" Value="Blue"/>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

