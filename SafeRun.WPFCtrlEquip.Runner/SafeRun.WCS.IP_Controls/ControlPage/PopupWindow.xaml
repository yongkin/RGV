<Window x:Class="SafeRun.WCS.IP_Controls.ControlPage.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SafeRun.WCS.IP_Controls.ControlPage"
        xmlns:IP_Controls="clr-namespace:SafeRun.WCS.IP_Controls"
        mc:Ignorable="d"
        Title="控件名称+控件编号" Height="240" Width="250" ResizeMode="NoResize" Loaded="Window_Loaded" >
    <Grid Height="205" Width="230"  >
        <Grid x:Name="grid_General" Width="200" Height="185">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="55"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Label x:Name="lab_showTitle" Content="控件名称+控件编号" HorizontalAlignment="Center" HorizontalContentAlignment="Center"></Label>
            </Grid>
            <Grid Grid.Row="1">
                <Label x:Name="lab_taskNo" Content="Task No" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtB_TaskNo" HorizontalAlignment="Left" Margin="65,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"/>
            </Grid>
            <Grid Grid.Row="2">
                <Label x:Name="lab_startingPoint" Content="起点" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtB_startingPoint" HorizontalAlignment="Left" Margin="65,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120" IsReadOnly="True" />
            </Grid>
            <Grid Grid.Row="3">
                <Label x:Name="lab_end" Content="终点" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtB_end" HorizontalAlignment="Left" Margin="65,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120" IsReadOnly="True" />
            </Grid>
            <Grid Grid.Row="4" >
                <Border BorderBrush="{x:Static IP_Controls:ColorLibrary.BorderColorB}" BorderThickness="1" />
                <Button x:Name="btn_updPlcTask" Content="Plc Task Upd" HorizontalAlignment="Left" Margin="5,7,0,0" VerticalAlignment="Top" Click="updateBtn_Click" Visibility="Visible"/>
                <Button x:Name="btn_cleanPlcTask" Content="Plc Task Clean" HorizontalAlignment="Left" Margin="5,0,5,7" VerticalAlignment="Bottom" Click="cleanBtn_Click" Visibility="Visible"/>
                
                <Button x:Name="btn_del" Content="Del Task" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="delBtn_Click" Margin="5,0,5,7"/>
                
                <Button x:Name="btn_Complete" Content="Complete Task" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,7,5,0" Click="btn_Complete_Click"/>


            </Grid>
            <Grid Grid.Row="5">
                <TextBlock x:Name="lab_tipInfo" Text="" Margin="0,4,0,2" />
            </Grid>

        </Grid>

        <Grid x:Name="grid_RGVInfo" Visibility="Hidden" >
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="27"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ListView x:Name="dataGrid_RGVInfo" >
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="小车编号" DisplayMemberBinding="{Binding RGVNo, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <GridViewColumn Header="任务号" DisplayMemberBinding="{Binding TaskNo, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <GridViewColumn Header="条码" DisplayMemberBinding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        </GridView>
                        
                    </ListView.View>
                </ListView>
            </Grid>
           
        </Grid>

    </Grid>
</Window>
